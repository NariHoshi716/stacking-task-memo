generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id        Int      @id @default(autoincrement())
  userName  String
  title     String
  content   String
  deadline  DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}
