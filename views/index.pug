h1 Stacking Task Memo

form(method="POST" action="/tasks")
  div
    label 担当者
    input(type="text" name="userName")

  div
    label タスク名
    input(type="text" name="title")

  div
    label 内容
    input(type="text" name="content")

  div
    label 締切日
    input(type="date" name="deadline")

  button(type="submit") 登録

each task in tasks
  div
    p= task.userName
    p= task.title
    p= task.content
    p= task.deadline.toLocaleDateString('ja-JP')

    if task.completed
      p 完了済み
    else
      p 未完了

    p= task.createdAt

    form(method="POST" action=`/tasks/${task.id}/delete`)
      button(type="submit") 削除

    if !task.completed
      form(method="POST" action=`/tasks/${task.id}/complete`)
        button(type="submit") 完了